/// Disconnected role axis for the Jaccard overlap matrix columns (5 comparison roles, no relationship by design)
table RoleB
	lineageTag: 32087d40-041c-4e1f-b643-24f6d2d489c3

	column Role
		isNameInferred
		sourceColumn: [Role]

	column Code
		sortByColumn: CodeSort
		isNameInferred
		sourceColumn: [Code]

	column CodeSort
		isHidden
		isNameInferred
		sourceColumn: [CodeSort]

	partition RoleB = calculated
		mode: import
		source = DATATABLE("Role", STRING, "Code", STRING, "CodeSort", INTEGER, {{"Data Analyst", "DA", 1},{"Business Analyst", "BA", 2},{"Data Engineer", "DE", 3},{"Data Scientist", "DS", 4},{"Software Engineer", "SE", 5}})

